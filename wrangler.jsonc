{
  // Worker UNIFICADO de TeGeVe: sirve el sitio estático + la IA "Tevi"
  // en el mismo origen (https://tegeve.gabrielgrosso.workers.dev).
  // Desplegar:  npx wrangler deploy   (desde la raíz del repo)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tegeve",
  "main": "worker-site/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Sitio multipágina (no SPA): si no existe el asset, 404.
    "not_found_handling": "404-page",
    // El Worker atiende /api/* y las páginas HTML (para poder negociar
    // Markdown con los agentes vía `Accept: text/markdown` y las URLs .md).
    // Las reglas negativas devuelven los assets pesados —CSS, JS, imágenes,
    // fuentes, sitemap, robots, llms.txt— a la vía rápida estática, que es
    // la inmensa mayoría de las peticiones.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/og.png",
      "!/og.svg",
      "!/favicon.ico",
      "!/sitemap.xml",
      "!/robots.txt",
      "!/llms.txt",
      "!/*.css",
      "!/*.js",
      "!/*.png",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.svg",
      "!/*.webp",
      "!/*.ico",
      "!/*.woff2",
      "!/*.xml",
      "!/*.txt"
    ]
  },
  // Workers AI (gratis, sin clave externa) para el asistente Tevi.
  "ai": { "binding": "AI" },
  // KV: almacenamiento permanente de las conversaciones e informes de Tevi Agent
  // (cada sesión completa, leads anónimos e identificados). Binding: TEVI_AGENT_KV.
  "kv_namespaces": [
    { "binding": "TEVI_AGENT_KV", "id": "bf9d0bdccb644ce48f1a0a4ddc541c4e" }
  ],
  // Analytics Engine: embudo de conversión de TevIA (apertura, primer mensaje,
  // email captado, urgencia alta, cita, cierre/abandono). Escrituras gratis, sin
  // tocar el KV de leads. Se consulta por SQL (Analytics Engine SQL API).
  // Nombres tal cual se crearon en el panel de Cloudflare.
  "analytics_engine_datasets": [
    { "binding": "Analytics_Engine", "dataset": "Analytics_Event" }
  ],
  "observability": { "enabled": true }
}
