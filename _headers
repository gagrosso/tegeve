# Cloudflare — cabeceras de respuesta del Worker con assets estáticos
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  # Descubrimiento para agentes (RFC 8288). Solo relaciones registradas
  # en IANA: "describedby" (llms.txt describe el sitio) y "author".
  Link: </llms.txt>; rel="describedby"; type="text/plain", </nosotros/>; rel="author"

# Versión Markdown de cada página (RFC 8288 "alternate"). La misma URL
# también responde en Markdown si se pide con `Accept: text/markdown`.
/
  Link: </index.md>; rel="alternate"; type="text/markdown"
/servicios/
